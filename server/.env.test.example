# Copy to server/.env.test. Loaded by `npm test` via `node --env-file`.
# Test-only value; nothing secret belongs in this file.
NODE_ENV=test
# P25. Left out on purpose: tests seal partner credentials with the development key.
# P62. Tests play each role themselves (setRoleForTest). These keep a developer's
# own .env (a box, a mirror) from leaking into the suite.
DEPLOYMENT_ROLE=CLOUD
MIRROR_URL=
REPLICATION_SECRET=
BOX_PUBLIC_URL=
BOX_LOCAL_NAME_URL=
BOX_WIFI_CONTROL=off
# P63. Tests play two-way sync themselves (setSyncModeForTest).
SYNC_MODE=ONE_WAY
