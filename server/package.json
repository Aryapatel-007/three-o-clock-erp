{
  "name": "restaurant-erp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for the restaurant ERP.",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --env-file=.env.test --test",
    "provision:restaurant": "node scripts/provisionRestaurant.js",
    "seed:demo": "node scripts/seedDemo.js",
    "seed:golden": "node --import ./scripts/lib/asTest.js scripts/loadGoldenDay.js",
    "db:restaurants": "node scripts/listRestaurants.js",
    "purge:restaurant": "node scripts/purgeRestaurant.js",
    "sandbox:order": "node scripts/sandboxOrder.js",
    "migrate:ready-to-served": "node scripts/migrateReadyToServed.js",
    "menu:sizes-to-dishes": "node scripts/sizesToDishes.js",
    "db:indexes": "node scripts/buildIndexes.js",
    "db:copy": "node scripts/copyDatabase.js",
    "setup:restaurant": "node scripts/setupRestaurant.js",
    "import:menu": "node scripts/importMenu.js",
    "smoke": "node scripts/smokeCheck.js",
    "assistant:eval": "node scripts/assistantEval.js",
    "backup:key": "node scripts/backupKey.js",
    "backup:list": "node scripts/backupList.js",
    "backup:restore": "node scripts/backupRestore.js",
    "backup:verify": "node scripts/backupVerify.js",
    "backup:drill": "node scripts/backupDrill.js",
    "replication": "node scripts/replication.js",
    "snapshot:local": "node scripts/localSnapshot.js",
    "copy:menu": "node scripts/copyMenuFromLive.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.4"
  }
}
