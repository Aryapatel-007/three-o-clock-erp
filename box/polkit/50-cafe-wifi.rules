// P62. Lets the POS server (user "cafe") move the box to another WiFi when
// the owner asks from the dashboard, and nothing else. Copied to
// /etc/polkit-1/rules.d/ only when BOX_WIFI_CONTROL=on is wanted.
// docs/STAFF-SETUP.md section 5.
polkit.addRule(function (action, subject) {
  if (subject.user !== "cafe") return polkit.Result.NOT_HANDLED;
  if (
    action.id === "org.freedesktop.NetworkManager.network-control" ||
    action.id === "org.freedesktop.NetworkManager.wifi.scan" ||
    action.id === "org.freedesktop.NetworkManager.settings.modify.system" ||
    action.id === "org.freedesktop.NetworkManager.enable-disable-wifi"
  ) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
