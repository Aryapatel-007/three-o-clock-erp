{
  "name": "restaurant-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant restaurant ERP. Root workspace.",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "lint": "eslint .",
    "provision:restaurant": "npm run provision:restaurant --workspace=server --",
    "seed:demo": "npm run seed:demo --workspace=server",
    "seed:golden": "npm run seed:golden --workspace=server",
    "db:restaurants": "npm run db:restaurants --workspace=server",
    "purge:restaurant": "npm run purge:restaurant --workspace=server --",
    "sandbox:order": "npm run sandbox:order --workspace=server --",
    "migrate:ready-to-served": "npm run migrate:ready-to-served --workspace=server --",
    "menu:sizes-to-dishes": "npm run menu:sizes-to-dishes --workspace=server --",
    "db:indexes": "npm run db:indexes --workspace=server",
    "setup:restaurant": "npm run setup:restaurant --workspace=server --",
    "import:menu": "npm run import:menu --workspace=server --",
    "smoke": "npm run smoke --workspace=server --",
    "assistant:eval": "npm run assistant:eval --workspace=server --",
    "backup:key": "npm run backup:key --workspace=server --",
    "backup:list": "npm run backup:list --workspace=server --",
    "backup:restore": "npm run backup:restore --workspace=server --",
    "backup:verify": "npm run backup:verify --workspace=server --",
    "backup:drill": "npm run backup:drill --workspace=server --",
    "replication": "npm run replication --workspace=server --",
    "snapshot:local": "npm run snapshot:local --workspace=server --",
    "copy:menu": "npm run copy:menu --workspace=server --",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:cloud": "playwright test --config e2e/cloud.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "exceljs": "^4.4.0"
  }
}
