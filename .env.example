# Copy this file to .env and fill in real values.
# .env is in .gitignore. Never commit it.
# If you add a variable here, tell the other developer in the same commit.

# --- Server ---
NODE_ENV=development
PORT=5000

# How many proxies sit in front of the server, so the rate limiter sees each
# device's real address. Leave empty on your laptop. In production it must be
# set: 1 on a host with one proxy in front, false if nothing sits in front.
# Never true: that lets anyone fake their address and skip the login limit.
TRUST_PROXY=

# --- Database ---
# Local: mongodb://127.0.0.1:27017/restaurant-erp
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/restaurant-erp
MONGO_URI=mongodb://127.0.0.1:27017/restaurant-erp

# --- Auth ---
# Generate with: openssl rand -base64 48
# These two must be different values.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string

# How long a login lasts. The refresh token renews on every use, so 365d means
# signed in until Sign out on any device used at least once a year.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=365d

# Cost factor for password hashing. 12 is a sane default.
BCRYPT_ROUNDS=12

# --- Client ---
# Where the React app runs. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# --- Rate limiting ---
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# --- Release ---
# Set by the host or the deploy to the git commit being deployed. Optional.
# Shown as "release" on GET /api/v1/health, so the smoke check can tell which
# version answered.
RELEASE_VERSION=

# --- Online payments (P24) ---
# Encrypts each cafe's Razorpay secrets in the database. 32 random bytes, base64.
# Generate with: openssl rand -base64 32
# Leave empty and online payment stays off; the page still takes requests.
# Losing this key means every cafe has to connect Razorpay again.
PAYMENT_SECRETS_KEY=

# --- Partner integrations (P25) ---
# Encrypts every partner credential: Pine Labs, Swiggy, Zomato. 32 random
# bytes, base64. Required in production; the server refuses to start without
# it. Generate with: openssl rand -base64 32
# Losing this key makes every saved partner credential unreadable: each has to
# be entered again on the Integrations page.
INTEGRATION_SECRETS_KEY=

# Razorpay's API address. Leave as it is; tests point it at a fake.
RAZORPAY_API_BASE=https://api.razorpay.com

# P44. The day-end email, through Resend. Leave RESEND_API_KEY empty and nothing
# is emailed. Until a domain is verified in Resend, onboarding@resend.dev only
# delivers to the address the Resend account was made with.
RESEND_API_KEY=
DAY_END_EMAIL_FROM=Three O'Clock <onboarding@resend.dev>
RESEND_API_BASE=https://api.resend.com

# P33. The live channel, on or off (the rollback). Default on.
LIVE_CHANNEL=on
# P33. Where screens open the live channel, when not the page's own address.
# Empty: Render's own address (RENDER_EXTERNAL_URL), else the page's own.
LIVE_ORIGIN=

# --- Display ---
# Stored time is always UTC. This is only used for formatting output.
DISPLAY_TIMEZONE=Asia/Kolkata

# --- Demo seed script ---
# Read directly by scripts/seedDemo.js, not by config/env.js: this is not
# something the running server needs, only something the seed script's own
# safety check consults. Comma-separated MONGO_URI hostnames the script is
# allowed to write demo data into when that URI is not localhost. Empty by
# default, so writing demo data anywhere but localhost is an explicit,
# deliberate opt-in, never an accident. Only ever name a shared development
# cluster here, never a production one.
SEED_DEMO_ALLOWED_HOSTS=

# Password for the demo seed accounts. Required by seedDemo.js; there is no default.
DEMO_PASSWORD=change-me

# --- Browser check against STAGING (npm run e2e:cloud), P25 ---
# Never production: it creates a real bill. E2E_CLOUD_DATABASE must equal the
# database name in MONGO_URI or it refuses to start. Developer machines only.
E2E_CLOUD_DATABASE=
E2E_CLOUD_RESTAURANT=
E2E_CLOUD_PASSWORD=
E2E_CLOUD_OWNER_PHONE=
E2E_CLOUD_CAPTAIN_PHONE=
E2E_CLOUD_COUNTER_PHONE=
# Every station a ticket goes to, as "Station name=phone", comma separated.
E2E_CLOUD_STATIONS=
E2E_CLOUD_TABLE=
E2E_CLOUD_DISH=
E2E_CLOUD_DRINK=

# --- Backups, P54 (docs/DEPLOYMENT.md section 8) ---
# off by default, and always off under NODE_ENV=test. With on, production
# refuses to start until every variable below except BACKUP_OLD_KEYS is set.
BACKUP_ENABLED=off
# 32 random bytes in base64, from: npm run backup:key. Lose it and every backup
# is unreadable. Keep a copy in a password manager.
BACKUP_ENCRYPTION_KEY=replace_me_with_npm_run_backup_key
# Retired keys, comma separated, for restoring old files only. Empty until a key changes.
BACKUP_OLD_KEYS=
BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKUP_S3_REGION=us-west-004
BACKUP_S3_BUCKET=example-bucket-name
# The server key: write only, this bucket only.
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
# The drill key, for the restore tools and the weekly practice restore only:
# read only, this bucket only. Never set on Render.
BACKUP_DRILL_KEY_ID=
BACKUP_DRILL_SECRET=

# --- The cafe box and its cloud mirror, P62 (docs/REPLICATION.md, docs/DEPLOYMENT.md sections 17 and 18) ---
# CLOUD (default): the hosted server, as before P62. BOX: the server in the cafe,
# the only writer. MIRROR: the cloud copy, read-only except intake until promoted.
DEPLOYMENT_ROLE=CLOUD
# P63. TWO_WAY on the cafe PC (BOX) and the cloud (CLOUD) together: both take
# bills, and the PC keeps them in step while the internet is up.
# Needs REPLICATION_SECRET, the same on both; on the PC also MIRROR_URL (the
# cloud's address). ONE_WAY (default) is P62. docs/REPLICATION.md section 13.
SYNC_MODE=ONE_WAY
# PC only, two-way: sync every SYNC_EVERY_SECONDS inside SYNC_HOURS (India time,
# past midnight is fine, or "always"); outside them only when the PC has changes
# waiting, at most every 15 minutes, so Render's free server sleeps at night.
SYNC_EVERY_SECONDS=60
SYNC_HOURS=08:30-02:30
# BOX only: the mirror's address. Unset, the box keeps its changelog and ships nothing.
MIRROR_URL=
# BOX and MIRROR: the same secret on both, from: openssl rand -base64 48
REPLICATION_SECRET=
# BOX only: local snapshots and the network notes live here.
BOX_DATA_DIR=
# BOX only: what staff open on a tablet, and the box's mDNS name, printed on the setup card.
# Leave both empty: the box works them out from the WiFi it is on now, and follows it
# to a new one. Set them only to pin a fixed address the router reserves.
BOX_PUBLIC_URL=
BOX_LOCAL_NAME_URL=
# BOX only: the WiFi adapter (found by itself when empty), and whether the owner
# may move the box to another WiFi from the dashboard (needs box/polkit set up).
BOX_WIFI_INTERFACE=
BOX_WIFI_CONTROL=off
# Windows cafe PC only: read by box/windows/update.mjs, never by the server.
# New signed versions from the GitHub releases of UPDATE_REPO install by themselves
# inside UPDATE_WINDOW (this PC's clock). UPDATE_TOKEN: a read-only fine-grained
# token for that repository (Contents: read). docs/WINDOWS-INSTALL.md section 6.
UPDATE_AUTO=on
UPDATE_WINDOW=04:00-05:00
UPDATE_REPO=Aryapatel-007/three-o-clock-erp
UPDATE_TOKEN=
